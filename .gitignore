# Large generated project artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
export/*.tflite
export/*.json

# Python caches and local environments
__pycache__/
*.pyc
.venv/
.streamlit/

# Hugging Face datasets cache
~/.cache/huggingface
