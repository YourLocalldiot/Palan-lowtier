# Large generated project artifacts (regenerated locally, not needed for deployment)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
checkpoints/*
!checkpoints/.gitkeep

# export/ is committed on purpose: it's the small deployable bundle Streamlit Cloud reads

# Python caches and local environments
__pycache__/
*.pyc
.venv/
.streamlit/

# Hugging Face datasets cache
~/.cache/huggingface
